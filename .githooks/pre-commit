#!/bin/sh
# Opcionális helyi gyorsellenőrzés commit előtt: a staged PHP fájlok
# szintaxisa. Nem helyettesíti a CI-t, csak a legbutább hibákat fogja meg.
#
# Bekapcsolás (egyszer, a klónozás után):
#   git config core.hooksPath .githooks
#
# Kikapcsolás:
#   git config --unset core.hooksPath
set -eu

files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.php$' || true)

if [ -z "$files" ]; then
  exit 0
fi

failed=0
for file in $files; do
  if ! php -l "$file" >/dev/null 2>&1; then
    echo "PHP szintaxis-hiba: $file" >&2
    php -l "$file" >&2 || true
    failed=1
  fi
done

exit $failed
