# Telepítéskor generált, gépspecifikus config (üzlet adatok, DB elérés)
/config/installer-generated.php

# Futásidejű adatok — ne kerüljenek verziókezelésbe
/data/*.sqlite
/data/*.sqlite-shm
/data/*.sqlite-wal
/data/.installed
/data/.install-token
/data/.backup-encryption-key
/data/settings.json
/data/settings.json.lock
/data/settings.json.before-restore-*
/data/geoip-cache.json
/data/nav-token-cache.json
/data/imports/*
!/data/imports/.gitkeep
/data/backups/*
!/data/backups/.gitkeep
/data/update-rollback/*
!/data/update-rollback/.gitkeep

# Ez a Claude Code munkakönyvtára — helyi eszköz-állapot, sose verziókezelt.
/.claude/

# Feltöltött, valós számlák (PDF)
/invoices/*
!/invoices/.gitkeep

# Feltöltött egyedi logók (az alapértelmezett logo-default.svg marad)
/webroot/assets/logo.*
/webroot/assets/print-logo.*

# Feltöltött termékképek
/webroot/assets/products/*
!/webroot/assets/products/.gitkeep

# OS / szerkesztő
Thumbs.db
.DS_Store

# Teszteléshez letöltött eszköz (nincs Composer ebben a projektben) —
# lásd README "Automatizált tesztek" szakasz a letöltéshez.
/tools/phpunit.phar
/.phpunit.cache
